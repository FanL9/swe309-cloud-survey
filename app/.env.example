# Copy the values you need into your platform's environment settings.
# Never commit real values (.env is git-ignored). See coordination/interfaces.md.

APP_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/tmp/survey.db
LOG_LEVEL=INFO
# Empty = log to stdout only (recommended in the cloud)
LOG_FILE=
EXPORT_DIR=/tmp/exports
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
STORAGE_BACKEND=sqlite

# Staff area (required in production; generate the hash with: python hash_password.py)
STAFF_USERNAME=
STAFF_PASSWORD_HASH=

# Reserved for the report page
C3_COUNTS_PATH=
